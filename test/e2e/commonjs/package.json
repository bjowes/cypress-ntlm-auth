{
  "name": "e2e-commonjs",
  "version": "1.0.0",
  "description": "e2e test with commonjs Cypress for cypress-ntlm-auth",
  "type": "commonjs",
  "scripts": {
    "webserver": "cd ../webserver && npm run webserver",
    "webserver:stop": "cd ../webserver && npm run webserver:stop",
    "cypress-ntlm:run": "npx cypress-ntlm run",
    "test": "npm-run-all -p -r webserver cypress-ntlm:run"
  },
  "author": "Björn Weström",
  "license": "MIT",
  "dependencies": {
    "cypress": "^16.3.0",
    "cypress-terminal-report": "^7.5.0",
    "cypress-wait-until": "^3.0.2",
    "npm-run-all": "^4.1.5"
  },
  "allowScripts": {
    "cypress": true,
    "file:../../../cypress-ntlm-auth-4.3.0.tgz": true
  }
}
